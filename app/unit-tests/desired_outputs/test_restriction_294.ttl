@prefix mod: <https://w3id.org/mod#> .
@prefix ns: <https://w3id.org/saref#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ns: a owl:Ontology ;
    mod:createdWith <https://chowlk.linkeddata.es/> .

ns:Class1 a owl:Class ;
    rdfs:label "Class1" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns:Class2 [ a owl:Restriction ;
                                owl:allValuesFrom [ a rdfs:Datatype ;
                                        owl:oneOf [ a rdf:List ;
                                                rdf:first "value1" ;
                                                rdf:rest [ a rdf:List ;
                                                        rdf:first "value2" ;
                                                        rdf:rest [ a rdf:List ;
                                                                rdf:first "value3" ;
                                                                rdf:rest () ] ] ] ] ;
                                owl:onProperty ns:datatypeProperty1 ] ) ] ;
            owl:onProperty ns:objectProperty ] .

ns:objectProperty a owl:ObjectProperty ;
    rdfs:label "object property" ;
    rdfs:domain ns:Class1 ;
    rdfs:range [ a owl:Class ;
            owl:intersectionOf ( ns:Class2 [ a owl:Restriction ;
                        owl:allValuesFrom [ a rdfs:Datatype ;
                                owl:oneOf [ a rdf:List ;
                                        rdf:first "value1" ;
                                        rdf:rest [ a rdf:List ;
                                                rdf:first "value2" ;
                                                rdf:rest [ a rdf:List ;
                                                        rdf:first "value3" ;
                                                        rdf:rest () ] ] ] ] ;
                        owl:onProperty ns:datatypeProperty1 ] ) ] .

ns:Class2 a owl:Class ;
    rdfs:label "Class2" .

ns:datatypeProperty1 a owl:DatatypeProperty ;
    rdfs:label "datatype property1" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf [ a rdf:List ;
                    rdf:first "value1" ;
                    rdf:rest [ a rdf:List ;
                            rdf:first "value2" ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first "value3" ;
                                    rdf:rest () ] ] ] ] .

